{
  "name": "@yaylib-dev/yayclient",
  "version": "0.0.2",
  "description": "Simple and intuitive, yet full featured API wrapper for https://yay.space written in TypeScript/JavaScript.This is a communuty-maintained fork of yay.js",
  "type": "commonjs",
  "source": "./src/index.ts",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "import": "./build/src/index.js",
      "default": "./build/src/index.js"
    }
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "rimraf ./build && tsc",
    "test": "jest",
    "docs": "typedoc",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaylib-dev/yayclient.git"
  },
  "keywords": ["yay", "api", "bot", "nanameue"],
  "author": "yaylib-dev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yaylib-dev/yayclient/issues"
  },
  "homepage": "https://github.com/yaylib-dev/yayclient#readme",
  "files": ["build"],
  "dependencies": {
    "axios": "^1.13.5",
    "colors": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "type-fest": "^5.4.4",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@biomejs/biome": "2.3.14",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.33",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "babel-jest": "^29.7.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.16",
    "typedoc-theme-hierarchy": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "volta": {
    "node": "22.2.0"
  }
}
